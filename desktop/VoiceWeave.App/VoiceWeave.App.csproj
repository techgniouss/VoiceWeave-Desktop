<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VoiceWeave</AssemblyName>
    <RootNamespace>VoiceWeave.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- English UI only: skip the ~10 translated satellite resource folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceWeave.Core\VoiceWeave.Core.csproj" />
    <ProjectReference Include="..\VoiceWeave.Win\VoiceWeave.Win.csproj" />
    <ProjectReference Include="..\VoiceWeave.Engine\VoiceWeave.Engine.csproj" />
  </ItemGroup>

  <!-- The LLamaSharp and sherpa-onnx packages carry natives for other systems (about 100 MB); this app is 64-bit Windows only. -->
  <Target Name="PruneForeignNatives" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes\linux-arm64;$(PublishDir)runtimes\linux-musl-x64;$(PublishDir)runtimes\linux-x64;$(PublishDir)runtimes\osx-arm64;$(PublishDir)runtimes\osx-x64;$(PublishDir)runtimes\win-arm64;$(PublishDir)runtimes\win-x86" />
  </Target>

</Project>

<Window x:Class="VoiceWeave.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceWeave" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" UseLayoutRounding="True">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <Border x:Name="Toast" Visibility="Collapsed" Background="#F2202024" CornerRadius="10" Padding="12,7"
                Margin="0,0,0,6" HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="#F5F5F7" FontSize="12.5" FontFamily="Segoe UI Variable Text, Segoe UI"
                       TextWrapping="Wrap" MaxWidth="280"/>
        </Border>
        <Border x:Name="Pill" Height="34" MinWidth="34" CornerRadius="17" Background="#E61C1C20" Cursor="Hand"
                BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center" Opacity="0.78"
                ToolTip="Hold Ctrl+Win, or hold / click this button, to dictate">
            <Grid Margin="9,0">
                <!-- idle: microphone -->
                <Viewbox x:Name="MicIcon" Width="16" Height="16" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#F5F5F7" Data="M12,2 A3.2,3.2 0 0 0 8.8,5.2 L8.8,11 A3.2,3.2 0 0 0 15.2,11 L15.2,5.2 A3.2,3.2 0 0 0 12,2 Z"/>
                        <Path Stroke="#F5F5F7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5.5,10.5 A6.5,6.5 0 0 0 18.5,10.5 M12,17 L12,21.5"/>
                    </Canvas>
                </Viewbox>
                <!-- recording: level bars -->
                <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" IsHitTestVisible="False"/>
                <!-- processing: dots -->
                <TextBlock x:Name="Dots" Visibility="Collapsed" Foreground="#F5F5F7" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-8,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>

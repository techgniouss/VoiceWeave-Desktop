<Window x:Class="VoiceWeave.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceWeave" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" UseLayoutRounding="True">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <!-- shown when a correction was added to the dictionary -->
        <Border x:Name="LearnToast" Visibility="Collapsed" Background="#F2102821" CornerRadius="12" Padding="12,9"
                Margin="0,0,0,6" HorizontalAlignment="Center" IsHitTestVisible="False"
                BorderBrush="#F2CB8C" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="#F2CB8C" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M5,4h11a3,3 0 0 1 3,3v13H8a3,3 0 0 1 -3,-3z M5,17a3,3 0 0 1 3,-3h11"/>
                    </Canvas>
                </Viewbox>
                <StackPanel>
                    <TextBlock Text="Added to your dictionary" Foreground="#F2CB8C" FontSize="11.5" FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                    <TextBlock x:Name="LearnToastText" Foreground="#F8F6EF" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextWrapping="Wrap" MaxWidth="300"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="Toast" Visibility="Collapsed" Background="#F2102821" CornerRadius="10" Padding="12,7"
                Margin="0,0,0,6" HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="#F8F6EF" FontSize="12.5" FontFamily="Segoe UI Variable Text, Segoe UI"
                       TextWrapping="Wrap" MaxWidth="280"/>
        </Border>
        <Border x:Name="Pill" Height="34" MinWidth="34" CornerRadius="17" Background="#F2102821" Cursor="Hand"
                BorderBrush="#5563B99C" BorderThickness="1" HorizontalAlignment="Center" Opacity="0.78"
                ToolTip="Hold Ctrl+Win, or hold / click this button, to dictate">
            <Grid Margin="9,0">
                <!-- idle: microphone -->
                <Viewbox x:Name="MicIcon" Width="17" Height="17" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <!-- the wave mark from the Android app -->
                        <Path Stroke="#A9F2CC" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4,10.5v3 M8,8v8 M12,4v16 M16,7v10 M20,10v4"/>
                    </Canvas>
                </Viewbox>
                <!-- recording: level bars -->
                <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" IsHitTestVisible="False"/>
                <!-- processing: dots -->
                <TextBlock x:Name="Dots" Visibility="Collapsed" Foreground="#F2CB8C" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-8,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>

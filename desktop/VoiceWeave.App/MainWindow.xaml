<Window x:Class="VoiceWeave.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceWeave" Width="1000" Height="680" MinWidth="820" MinHeight="560"
        Background="{StaticResource Paper}" TextElement.Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="{StaticResource Ink}" Padding="16,22,16,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VoiceWeave" Foreground="White" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                        <TextBlock Text="Voice typing on your PC" Foreground="#8FB5A5" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,0,0,0">
                    <Border Background="#18382F" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Gold}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Starting…" Foreground="#CFE6DB" FontSize="12.5" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="150"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="QuitButton" Content="Quit VoiceWeave" Style="{StaticResource GhostButton}" Foreground="#CFE6DB" Click="OnQuit"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Content="Home" GroupName="nav" IsChecked="True" Style="{StaticResource NavButton}" Checked="OnNav">
                        <RadioButton.Tag><Path Stroke="{StaticResource Mint}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,10.5v3 M8,8v8 M12,4v16 M16,7v10 M20,10v4" Width="20" Height="20" Stretch="Uniform"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavHistory" Content="History" GroupName="nav" Style="{StaticResource NavButton}" Checked="OnNav">
                        <RadioButton.Tag><Path Stroke="{StaticResource Mint}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12,7v5l3.5,2 M21,12a9,9 0 1 1 -18,0a9,9 0 1 1 18,0" Width="20" Height="20" Stretch="Uniform"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavDictionary" Content="Dictionary" GroupName="nav" Style="{StaticResource NavButton}" Checked="OnNav">
                        <RadioButton.Tag><Path Stroke="{StaticResource Mint}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5,4h11a3,3 0 0 1 3,3v13H8a3,3 0 0 1 -3,-3z M5,17a3,3 0 0 1 3,-3h11" Width="20" Height="20" Stretch="Uniform"/></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Content="Settings" GroupName="nav" Style="{StaticResource NavButton}" Checked="OnNav">
                        <RadioButton.Tag><Path Stroke="{StaticResource Mint}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,7h9 M17,7h3 M4,17h3 M11,17h9 M15,4v6 M9,14v6" Width="20" Height="20" Stretch="Uniform"/></RadioButton.Tag>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1">
            <!-- HOME -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{StaticResource Mint}" CornerRadius="14" Padding="20,14" Margin="0,0,0,16">
                        <DockPanel>
                            <Button x:Name="UpdateInstall" DockPanel.Dock="Right" Content="Update now" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" Click="OnInstallUpdate"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateTitle" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="14.5"/>
                                <TextBlock x:Name="UpdateDetail" Foreground="{StaticResource Ink}" Opacity="0.8" FontSize="12.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="WelcomeCard" Background="{StaticResource Ink}" CornerRadius="18" Padding="28,26" Margin="0,0,0,20" ClipToBounds="True">
                        <Grid>
                            <Canvas Width="280" Height="56" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9" Margin="0,-6,-6,0">
                                <Path Stroke="#32584A" StrokeThickness="1" Data="M0,50H280"/>
                                <Path Stroke="{StaticResource Teal}" StrokeThickness="2" StrokeStartLineCap="Round" Data="M1,32C24,32 29,13 48,13S76,47 102,47S132,16 155,16S188,40 210,40S243,25 264,25"/>
                                <Path Stroke="{StaticResource Mint}" StrokeThickness="2.4" StrokeStartLineCap="Round" Data="M1,24C24,24 29,43 48,43S76,9 102,9S132,40 155,40S188,16 210,16S243,31 264,31"/>
                                <Ellipse Canvas.Left="268" Canvas.Top="24" Width="8" Height="8" Fill="{StaticResource Gold}"/>
                            </Canvas>
                            <StackPanel>
                                <TextBlock x:Name="WelcomeTitle" Text="Welcome to VoiceWeave" Foreground="White" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,38,0,6"/>
                                <TextBlock Text="Speak instead of typing, in any app. Your voice is recognised on this PC and never leaves it." Foreground="#CFE6DB" FontSize="14" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
                                <StackPanel Margin="0,20,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,4"><Border Background="{StaticResource Mint}" CornerRadius="11" Width="22" Height="22"><TextBlock Text="1" Foreground="{StaticResource Ink}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Click into any text box: a document, a chat, a browser." Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4"><Border Background="{StaticResource Mint}" CornerRadius="11" Width="22" Height="22"><TextBlock Text="2" Foreground="{StaticResource Ink}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Hold Ctrl + Win and speak. Let go and the text appears." Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4"><Border Background="{StaticResource Mint}" CornerRadius="11" Width="22" Height="22"><TextBlock Text="3" Foreground="{StaticResource Ink}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Or press and hold the small bar at the bottom of your screen, or click it once to start and again to stop." Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/></StackPanel>
                                </StackPanel>
                                <Button x:Name="WelcomeDismiss" Content="Got it" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="OnDismissWelcome"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Home" Style="{StaticResource H1}" x:Name="HomeTitle"/>
                    <TextBlock Text="Everything you need to dictate, in one place." Style="{StaticResource Subtle}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Language" Style="{StaticResource H2}"/>
                            <TextBlock Text="Pick one language, or an English + Telugu / Hindi / Tamil mode that detects which one you are speaking, sentence by sentence." Style="{StaticResource Subtle}" Margin="0,0,0,12"/>
                            <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"/>
                            <CheckBox x:Name="RomanBox" Content="Write Telugu, Hindi and Tamil in English letters" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="OnRomanClicked"/>
                            <TextBlock Text="Hold Shift as well (Ctrl + Win + Shift) to send one dictation straight to the regional language in an English + … mode." Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Try it here" Style="{StaticResource H2}"/>
                            <TextBlock Text="Click in the box, then hold Ctrl + Win and say something." Style="{StaticResource Subtle}" Margin="0,0,0,10"/>
                            <TextBox x:Name="TryBox" MinHeight="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            <TextBlock x:Name="LastInfo" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource H2}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Hold Ctrl + Win" FontWeight="SemiBold" Margin="0,4"/><TextBlock Grid.Row="0" Grid.Column="1" Text="Speak; release to type" Style="{StaticResource Subtle}" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Text="Double-tap Ctrl + Win" FontWeight="SemiBold" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Hands-free; tap again to finish" Style="{StaticResource Subtle}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Text="Esc" FontWeight="SemiBold" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Cancel this dictation" Style="{StaticResource Subtle}" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Text="Ctrl + Win + Shift" FontWeight="SemiBold" Margin="0,4"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Use the regional language for this dictation" Style="{StaticResource Subtle}" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Text="Ctrl + Win + L" FontWeight="SemiBold" Margin="0,4"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Select the corrected word first: learn it from the last dictation" Style="{StaticResource Subtle}" Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- HISTORY -->
            <Grid x:Name="HistoryPage" Visibility="Collapsed" Margin="36,30,36,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource H1}"/>
                    <TextBlock Text="What you dictated, newest first. Only the text is kept, never the audio." Style="{StaticResource Subtle}" Margin="0,0,0,16"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="Search your history" MinHeight="40" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Search your dictations" Foreground="#8A968F" FontSize="14" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="HistoryCount" Grid.Column="1" VerticalAlignment="Center" Margin="14,0" Style="{StaticResource Subtle}"/>
                    <Button x:Name="ClearAll" Grid.Column="2" Content="Clear all" Style="{StaticResource DangerButton}" Click="OnClearHistory"/>
                </Grid>
                <Grid Grid.Row="2">
                    <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding When}" Style="{StaticResource Subtle}" FontWeight="SemiBold"/>
                                                <Border Background="{StaticResource Chip}" CornerRadius="9" Padding="8,1" Margin="10,0,0,0"><TextBlock Text="{Binding Mode}" FontSize="11.5" Foreground="{StaticResource Accent}"/></Border>
                                            </StackPanel>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" FontSize="14.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <Button Content="Copy" Tag="{Binding Id}" Style="{StaticResource GhostButton}" Click="OnCopyEntry" Margin="0,0,6,0"/>
                                            <Button Content="Delete" Tag="{Binding Id}" Style="{StaticResource DangerButton}" Click="OnDeleteEntry"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="HistoryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,40,0,0">
                        <TextBlock x:Name="HistoryEmptyTitle" Text="Nothing here yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="HistoryEmptyText" Text="Your dictations will appear here." Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="KeepHistoryBox" Content="Keep a history of my dictations" Style="{StaticResource Switch}" Click="OnKeepHistoryClicked" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="Delete after" VerticalAlignment="Center" Margin="24,0,10,0" Style="{StaticResource Subtle}"/>
                        <ComboBox x:Name="RetentionBox" Grid.Column="2" SelectionChanged="OnRetentionChanged" MinWidth="120"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- DICTIONARY -->
            <Grid x:Name="DictionaryPage" Visibility="Collapsed" Margin="36,30,36,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Dictionary" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,14" Text="Words the recogniser gets wrong. One rule per line: what it hears, then =&gt;, then what you want, for example  quark us =&gt; Quarkus. When you fix a word in a text box after dictating, VoiceWeave adds the rule here for you."/>
                </StackPanel>
                <TextBox x:Name="DictionaryBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13.5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnDictionaryEdited"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="DictionarySave" Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSaveDictionary" IsEnabled="False"/>
                    <Button x:Name="DictionaryRevert" Content="Revert" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnRevertDictionary" IsEnabled="False"/>
                    <TextBlock x:Name="DictionaryStatus" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource Subtle}"/>
                </StackPanel>
            </Grid>

            <!-- SETTINGS -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Stretch">
                    <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                    <TextBlock Text="Changes apply straight away." Style="{StaticResource Subtle}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="General" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="StartupBox" Content="Start VoiceWeave when I sign in to Windows" Style="{StaticResource Switch}" Click="OnStartupClicked"/>
                            <TextBlock Text="On after a normal install. You can also turn it off in Windows Settings, under Apps, Startup." Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="BarBox" Content="Show the floating bar on screen" Style="{StaticResource Switch}" Click="OnBarClicked"/>
                            <CheckBox x:Name="LearnBox" Content="Learn from my corrections" Style="{StaticResource Switch}" Click="OnLearnClicked"/>
                            <TextBlock Text="When you fix a misheard word after dictating, it is added to your dictionary." Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="SoundAlikeBox" Content="Match words that sound like my dictionary terms" Style="{StaticResource Switch}" Click="OnSoundAlikeClicked"/>
                            <TextBlock Text="After you teach it Srikanth, it also fixes Sreekant or Sri Kanth. It is a guess, so turn it off if it rewrites a word it should not." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically" Style="{StaticResource Switch}" Click="OnAutoUpdateClicked"/>
                            <TextBlock Text="Looks at the project's GitHub releases. Nothing is installed until you click Update now." Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckNowButton" Content="Check for updates now" Style="{StaticResource GhostButton}" Click="OnCheckNow"/>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Cleanup (optional)" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="ToneAppBox" Content="Match my writing style to the app" Style="{StaticResource Switch}" Click="OnToneAppClicked"/>
                            <TextBlock Text="Chat apps like Slack or Teams get a relaxed style, mail and documents a formal one. Only the name of the program in front is looked at, nothing is stored, and it adds no delay." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <CheckBox x:Name="FasterBox" Content="Faster cleanup (smaller model)" Style="{StaticResource Switch}" Click="OnFasterClicked"/>
                            <TextBlock Text="Uses a smaller copy of the cleanup model: about 30% quicker and 230 MB smaller, with another 380 MB of disk space. It is made once on this computer, from the model already downloaded, and takes about a minute. Some answers differ a little, for example 'fifteenth' may become '15' instead of '15th'." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="FasterStatusText" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <CheckBox x:Name="VocabBox" Content="Improve accuracy with my vocabulary" Style="{StaticResource Switch}" Click="OnVocabClicked"/>
                            <TextBlock Text="Shows the cleanup model your 20 newest dictionary terms so it spells them your way. Cleanup takes roughly 0.2 to 0.7 seconds longer on sentences it works on, more the longer your dictionary is. It can occasionally get a sentence wrong, so leave it off if you prefer speed." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Wake word" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="WakeBox" Content="Start dictating when I say a phrase" Style="{StaticResource Switch}" Click="OnWakeClicked"/>
                            <TextBlock Text="Hands-free: say the phrase, then speak. It stops by itself after you go quiet. Esc cancels, Ctrl+Win finishes. Needs a small extra model (downloaded once) and listens through the microphone only on this computer." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="WakePhraseBox" Width="240" MaxLength="40"/>
                                <Button Content="Set phrase" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnSetWakePhrase"/>
                            </StackPanel>
                            <TextBlock x:Name="WakeStatusText" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                            <CheckBox x:Name="WakeCloseBox" Content="Only respond to close, clear speech" Style="{StaticResource Switch}" Click="OnWakeCloseClicked"/>
                            <TextBlock Text="Ignores the phrase when it is quiet, like a TV or people talking across the room. Turn it off if it misses you when you speak softly or sit far from the microphone." Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Speech models" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ModelsPath" Style="{StaticResource Subtle}" Margin="0,0,0,10"/>
                            <Button Content="Open models folder" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnOpenModels"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Troubleshooting" Style="{StaticResource H2}"/>
                            <TextBlock Text="The log records what happened and how long it took, never what you said." Style="{StaticResource Subtle}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open log" Style="{StaticResource GhostButton}" Click="OnOpenLog"/>
                                <Button Content="Open data folder" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnOpenData"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="AboutText" Style="{StaticResource Subtle}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Project page" Style="{StaticResource GhostButton}" Click="OnOpenProject"/>
                                <Button Content="Open-source licences" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnOpenLicences"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
